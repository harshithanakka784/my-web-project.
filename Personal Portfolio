<head>
    <title>Harshitha | Personal Portfolio</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6fb;
            color: #222;
            line-height: 1.6;
        }

        nav {
            background-color: #171738;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        nav h2 {
            color: #ffffff;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 20px;
            flex-wrap: wrap;
        }

        nav a {
            color: white;
            text-decoration: none;
            transition: color 0.3s;
        }

        nav a:hover {
            color: #61dafb;
        }

        
        .hero {
            min-height: 85vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 50px 20px;
            background: linear-gradient(135deg, #171738, #5145a5);
            color: white;
            animation: fadeIn 1.5s ease;
        }

        .hero h1 {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .hero span {
            color: #61dafb;
        }

        .hero p {
            font-size: 19px;
            margin-bottom: 25px;
        }

        .btn {
            display: inline-block;
            background-color: #61dafb;
            color: #171738;
            padding: 12px 25px;
            border-radius: 25px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
            margin: 5px;
        }

        .btn:hover {
            background-color: white;
            transform: translateY(-4px);
        }

        
        section {
            padding: 65px 8%;
        }

        .section-title {
            text-align: center;
            color: #292967;
            font-size: 30px;
            margin-bottom: 30px;
        }

        .about {
            text-align: center;
            max-width: 850px;
            margin: auto;
        }

        
        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 22px;
        }

        .card {
            background-color: white;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 5px 18px rgba(0, 0, 0, 0.08);
            transition: transform 0.3s, box-shadow 0.3s;
            animation: fadeIn 1s ease;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
        }

        .card h3 {
            color: #5145a5;
            margin-bottom: 12px;
        }

        .card p {
            margin-bottom: 8px;
        }

        
        .skill {
            margin-bottom: 20px;
        }

        .skill p {
            font-weight: bold;
            margin-bottom: 7px;
        }

        .progress {
            height: 12px;
            background-color: #ddd;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress div {
            height: 100%;
            background: linear-gradient(90deg, #5145a5, #61dafb);
            border-radius: 10px;
            animation: grow 1.5s ease;
        }

    
        .contact {
            background-color: #e9eafa;
            text-align: center;
        }

        .contact p {
            margin: 12px 0;
        }

        .contact a {
            color: #5145a5;
            text-decoration: none;
        }

        .contact a:hover {
            text-decoration: underline;
        }

        
        footer {
            background-color: #171738;
            color: white;
            text-align: center;
            padding: 20px;
        }

    
        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes grow {
            from {
                width: 0;
            }
        }

    
        @media (max-width: 600px) {
            nav {
                justify-content: center;
                text-align: center;
            }

            nav ul {
                justify-content: center;
                gap: 12px;
            }

            .hero h1 {
                font-size: 32px;
            }

            .hero p {
                font-size: 16px;
            }

            section {
                padding: 45px 6%;
            }

            .section-title {
                font-size: 25px;
            }
        }
    </style>
</head>

