<!DOCTYPE html>
<html lang="en">
<head>
    <title>College Information Website</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #333;
            line-height: 1.6;
        }

        nav {
            background: #123456;
            color: white;
            padding: 18px 7%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 15px;
        }

        nav h2 {
            color: #ffcc66;
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 20px;
            flex-wrap: wrap;
        }

        nav a {
            color: white;
            text-decoration: none;
            transition: 0.3s;
        }

        nav a:hover {
            color: #ffcc66;
        }

        .banner {
            background: linear-gradient(135deg, #123456, #247ba0);
            color: white;
            text-align: center;
            padding: 90px 20px;
            animation: fadeIn 1.5s ease;
        }

        .banner h1 {
            font-size: 42px;
            margin-bottom: 15px;
        }

        .banner p {
            font-size: 18px;
        }

        .btn {
            display: inline-block;
            background: #ffcc66;
            color: #123456;
            padding: 12px 25px;
            margin-top: 20px;
            text-decoration: none;
            border-radius: 6px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            background: white;
            transform: translateY(-4px);
        }

        section {
            padding: 55px 8%;
        }

        .title {
            text-align: center;
            color: #123456;
            font-size: 30px;
            margin-bottom: 30px;
        }

        .about {
            text-align: center;
            max-width: 850px;
            margin: auto;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 25px;
        }

        .card {
            background: white;
            padding: 25px;
            border-radius: 10px;
            text-align: center;
            box-shadow: 0 5px 15px #00000015;
            transition: 0.3s;
            animation: fadeIn 1s ease;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 10px 22px #00000025;
        }

        .card h3 {
            color: #247ba0;
            margin-bottom: 12px;
        }

        .contact {
            background: #e5eef7;
            text-align: center;
        }

        footer {
            background: #123456;
            color: white;
            text-align: center;
            padding: 20px;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 600px) {
            nav {
                justify-content: center;
            }

            nav ul {
                justify-content: center;
                gap: 12px;
            }

            .banner h1 {
                font-size: 30px;
            }

            section {
                padding: 40px 6%;
            }
        }
    </style>
</head>

<body>

    <nav>
        <h2>ABC College</h2>

